# Optional: CLI credentials. The landing page asks each user for their own.
SLINGR_EMAIL=
SLINGR_PASSWORD=

# Outlook shared calendar (Microsoft Graph application credentials)
# Grant the app Calendars.Read application permission with admin consent.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OUTLOOK_CALENDAR_USER=
# Optional: blank uses that user's default calendar.
OUTLOOK_CALENDAR_ID=

